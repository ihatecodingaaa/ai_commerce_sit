# =============================================================================
# shop-lab environment configuration (EXAMPLE — copy to .env and edit)
# =============================================================================
# This is an intentionally vulnerable training lab. Every value below is a
# fake laboratory credential. Do NOT put real secrets in this file or in .env.

SECRET_KEY=lab-not-a-real-secret-change-me

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Database (SQLite file path, relative to project root)
DATABASE_URL=database/shop_lab.db

# Ollama local LLM backend
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:1.5b was tried here as a faster default and reverted: a direct
# A/B against qwen2.5:3b on this app's exact system prompt/tool schemas
# showed 1.5b never emitted a tool call (not even for a direct "what are
# my orders" question), while 3b called the right tool every time. Since
# Stage 3 onward -- including the Stage 4/5 injection chain -- depends on
# the model actually calling knowledge_base_search, a faster model that
# skips tool calls breaks the lab rather than just answering slower. Speed
# comes from OLLAMA_KEEP_ALIVE/NUM_CTX/NUM_PREDICT below instead.
OLLAMA_MODEL=qwen2.5:3b
# CPU-only inference on a 2 vCPU box gets slower as conversation history and
# retrieved tool-result context grow -- a multi-turn chat can take 1-2+
# minutes for a single reply. 240s avoids the app's own client-side timeout
# firing before Ollama actually finishes.
OLLAMA_TIMEOUT_SECONDS=240
# How long Ollama keeps the model loaded in memory between requests.
# Ollama's own default (5m) means most real chat gaps (reading a reply,
# writing a follow-up) evict the model, so the *next* message pays a full
# reload on top of inference -- often the biggest chunk of "it took a
# minute" in practice. 30m keeps it warm for a whole lab session.
OLLAMA_KEEP_ALIVE=30m
# Context window and max reply length. Actual usage (system prompt + tool
# schemas + <=20 history messages + a few retrieved KB articles) fits well
# under 4096 tokens; letting Ollama fall back to a model's much larger
# default context allocates a bigger KV-cache than this app ever needs,
# which costs real time per generated token on CPU.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=400

# --- Intentionally vulnerable lab credential -------------------------------
# The "support-image-service" bearer token is NOT set here. It is randomly
# generated at seed time and rotated automatically on the interval below,
# with only its hash ever persisted to the database -- see
# app/services/credentials.py and app/services/rotation.py. It is
# intentionally discoverable by a student who successfully exploits the
# chatbot's indirect prompt-injection trust-boundary flaw (see
# docs/attack-timeline.md, Stage 6), same as a real leaked credential would
# be, and it goes stale on the same schedule a real one would too.
TOKEN_ROTATION_INTERVAL_SECONDS=1800

# Upload directory used by the vulnerable internal image API
UPLOAD_DIR=uploads/images

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
